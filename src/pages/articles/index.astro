---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { selectArticles } from '../../lib/articles';
const articles = selectArticles(await getCollection('articles'), import.meta.env.DEV);
---
<SiteLayout title="文章 · 随机幂等" description="随机幂等的文章与技术记录。" active="articles">
  <section class="writing-page" aria-labelledby="writing-title">
    <p class="eyebrow">WRITING · 文章</p>
    <h1 class="writing-title" id="writing-title">文章</h1>
    <ArticleList articles={articles} />
  </section>
</SiteLayout>
