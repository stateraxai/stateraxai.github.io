---
import MusicPlayer from './MusicPlayer.astro';
import type { BlogCategory } from '../lib/articles';
interface Props { active?: 'home' | BlogCategory | 'about'; }
const { active } = Astro.props;
---
<div class="nav-border">
  <div class="nav-inner wrap">
  <nav class="main-nav" aria-label="主导航">
    <a href="/" aria-current={active === 'home' ? 'page' : undefined}>首页</a>
    <a href="/tech/" aria-current={active === 'tech' ? 'page' : undefined}>技术</a>
    <a href="/#projects">项目</a>
    <a href="/science/" aria-current={active === 'science' ? 'page' : undefined}>科普</a>
    <a href="/notes/" aria-current={active === 'notes' ? 'page' : undefined}>随想</a>
    <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>关于</a>
  </nav>
  <MusicPlayer />
  </div>
</div>
