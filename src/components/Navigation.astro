---
interface Props { active?: 'home' | 'articles' | 'about'; }
const { active } = Astro.props;
---
<div class="nav-border">
  <nav class="main-nav wrap" aria-label="主导航">
    <a href="/" aria-current={active === 'home' ? 'page' : undefined}>首页</a>
    <a href="/articles/" aria-current={active === 'articles' ? 'page' : undefined}>文章</a>
    <a href="/#projects">项目</a>
    <a href="/#notes">随想</a>
    <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>关于</a>
  </nav>
</div>
